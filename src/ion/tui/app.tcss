Screen {
    background: #0e1113;
    color: #e5e9e8;
}

#masthead {
    height: 3;
    margin: 0 2;
    padding: 1 0 0 0;
    border-bottom: solid #293237;
}

#masthead-brand {
    width: 8;
    color: #82b7b5;
    text-style: bold;
}

#masthead-title {
    width: 1fr;
    color: #8c9698;
}

#masthead-command {
    width: auto;
    color: #697477;
}

#body {
    height: 1fr;
    padding: 1 2 0 2;
}

#main {
    width: 1fr;
    height: 1fr;
}

#center {
    height: 1fr;
    align: center middle;
}

#home {
    height: auto;
    width: 70;
    max-width: 100%;
    margin: 0 0 3 0;
}

Brand {
    width: 100%;
    height: 7;
    content-align: left middle;
}

#home-caption {
    height: 2;
    padding-top: 1;
    color: #687376;
}

#session-header {
    display: none;
    height: 3;
    padding: 1 0 0 0;
    color: #e5e9e8;
    text-style: bold;
    border-bottom: solid #293237;
}

#activity {
    display: none;
    height: 1fr;
    padding: 1 0;
    background: #0e1113;
    border: none;
    scrollbar-size: 1 1;
    scrollbar-color: #4e6067;
    scrollbar-background: #151a1d;
}

#composer-wrap {
    height: auto;
    width: 70;
    max-width: 100%;
}

#composer-label {
    height: 1;
    color: #82b7b5;
    text-style: bold;
}

#command-suggestions {
    display: none;
    height: auto;
    max-height: 7;
    margin-bottom: 1;
    padding: 0;
    background: #151a1d;
    border: solid #324047;
    scrollbar-size: 1 1;
}

#command-suggestions > .option-list--option-highlighted {
    background: #253036;
    color: #e5e9e8;
    text-style: bold;
}

.suggesting #home {
    display: none;
}

#composer {
    height: auto;
    width: 100%;
    margin-top: 1;
    padding: 1 1 0 1;
    background: #151a1d;
    border: solid #324047;
}

#task {
    height: 3;
    min-height: 3;
    max-height: 8;
    padding: 0;
    background: #151a1d;
    color: #e5e9e8;
    border: none;
}

#task:focus {
    border: none;
}

#composer-meta {
    height: 2;
    padding: 0;
    background: #151a1d;
    align-vertical: middle;
}

#profile {
    width: 1fr;
    height: 1;
    color: #8c9698;
}

#run, #cancel {
    min-width: 7;
    width: auto;
    height: 1;
    margin: 0 0 0 1;
    padding: 0 1;
    background: #151a1d;
    color: #82b7b5;
    border: none;
    text-style: bold;
}

#cancel {
    display: none;
    color: #c5a56a;
}

#run:hover, #cancel:hover {
    background: #253036;
}

#hints {
    height: 2;
    padding-top: 1;
    color: #616c70;
    text-align: left;
}

#status {
    height: 2;
    padding-top: 1;
    color: #9aa3a4;
    text-overflow: ellipsis;
}

#sidebar {
    display: none;
    width: 30;
    margin-left: 2;
    padding: 1 1;
    background: #111619;
    border-left: solid #293237;
}

#sidebar-title {
    height: 2;
    color: #82b7b5;
    text-style: bold;
    border-bottom: solid #293237;
}

.side-heading {
    height: auto;
    margin-top: 1;
    color: #727e81;
}

.side-text {
    height: auto;
    margin: 0 0 1 0;
    color: #c0c7c6;
}

#bottom {
    height: 2;
    margin: 0 2;
    padding-top: 1;
    color: #616c70;
    border-top: solid #293237;
}

#cwd {
    width: 1fr;
}

#version {
    width: auto;
    color: #727e81;
}

.session #center {
    height: auto;
    align: center bottom;
}

.session #home {
    display: none;
}

.session #composer-wrap {
    width: 100%;
}

.session #session-header,
.session #activity {
    display: block;
}

.session.sidebar-visible #sidebar {
    display: block;
}

.session.narrow #sidebar {
    display: none;
}

.narrow #masthead {
    margin: 0 1;
}

.narrow #masthead-title {
    display: none;
}

.narrow #body {
    padding: 1 1 0 1;
}

.narrow #bottom {
    margin: 0 1;
}

.narrow #home {
    margin-bottom: 1;
}

.narrow #hints {
    height: 3;
}

.short #masthead {
    height: 2;
    padding-top: 0;
}

.short #home-caption {
    display: none;
}

.short #home {
    margin-bottom: 1;
}

.short #status {
    height: 1;
    padding-top: 0;
}

Picker,
EntryDialog {
    align: center middle;
    background: #07090a 72%;
}

#dialog,
#entry-dialog {
    width: 68;
    max-width: 92%;
    height: auto;
    max-height: 82%;
    padding: 1 2;
    background: #151a1d;
    border: solid #324047;
}

#dialog-title {
    height: 2;
    color: #e5e9e8;
    text-style: bold;
    border-bottom: solid #293237;
}

#dialog-hint {
    height: auto;
    margin-top: 1;
    color: #727e81;
}

#filter,
#entry {
    height: 3;
    margin: 1 0;
    padding: 1;
    background: #0e1113;
    color: #e5e9e8;
    border: solid #324047;
}

#filter:focus,
#entry:focus {
    border: solid #82b7b5;
}

#choices {
    height: auto;
    min-height: 2;
    max-height: 15;
    padding: 0;
    background: #151a1d;
    border: none;
}

#choices > .option-list--option-highlighted {
    background: #253036;
    color: #e5e9e8;
    text-style: bold;
}
