AI_API_KEY=
# Universal connection: deepseek, qwen, groq, openrouter, openai, or a custom name.
# Routing settings make AI_API_KEY the sole credential for this connection.
AI_PROVIDER=
AI_MODEL=
# Optional for known providers; required with AI_MODEL for custom services.
# For Qwen, use the endpoint matching the region where your key was issued.
AI_BASE_URL=
# An externally exported AI_API_KEY automatically locks evaluation and skips .env.
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
